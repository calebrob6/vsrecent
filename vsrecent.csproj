<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>VsRecent</RootNamespace>
    <AssemblyName>vsrecent</AssemblyName>
    <ApplicationIcon>vsrecent.ico</ApplicationIcon>

    <Version>0.2.0</Version>
    <Authors>Caleb Robinson</Authors>
    <Copyright>Copyright (c) 2026 Caleb Robinson</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/calebrob6/vsrecent</RepositoryUrl>
    <Product>VS Recent</Product>
    <Description>Tiny launcher for VSCode "Open Recent" projects.</Description>

    <!-- Publish properties (only effective during `dotnet publish`) -->
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
